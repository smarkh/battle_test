# Copy to .env on the server (next to docker-compose.yml) and fill in.
# .env is gitignored. Never commit it or paste its values anywhere.

# battle_test's own Cloudflare Tunnel token (Zero Trust dashboard > Networks >
# Tunnels > battle-test > the token in the "Install connector" command).
# This is a separate tunnel from smark_iq's.
BATTLE_TUNNEL_TOKEN=
